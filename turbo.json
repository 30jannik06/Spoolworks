{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["DATABASE_URL", "DIRECT_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "BLOB_READ_WRITE_TOKEN"],
  "tasks": {
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false, "persistent": true },
    "db:deploy": { "cache": false },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": { "dependsOn": ["^db:generate"], "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^db:generate"] },
    "lint": {},
    "test": { "dependsOn": ["^db:generate"] }
  }
}

// SpoolWorks data model. Single source of truth; see the repo CLAUDE.md for the
// rules behind it (ownership via Workshop, catalog vs owned spool, ledger).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core tables ──────────────────────────────────────────────────
// Shape required by Better Auth 1.7 (email + password). Better Auth's own
// "Account" is a login method, not a SpoolWorks account: the tenant is Workshop.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  workshop Workshop?

  createdProducts FilamentProduct[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hashed by Better Auth for the email/password provider; null for OAuth.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── SpoolWorks ───────────────────────────────────────────────────────────────

/// The tenant. Every owned row (spools, printers, prints) hangs off a workshop,
/// never off the user directly, so sharing a workshop later is not a schema break.
/// Created automatically when a user signs up (1:1 for now).
model Workshop {
  id                 String   @id @default(cuid())
  ownerId            String   @unique
  name               String   @default("Meine Werkstatt")
  /// Spools at or below this net weight (grams) show a low-stock warning.
  lowStockThresholdG Int      @default(150)
  /// Whole gallery public at /u/<publicHandle>. Inventory is never public.
  galleryPublic      Boolean  @default(false)
  publicHandle       String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  spools   Spool[]
  printers Printer[]
  prints   Print[]
  photos   PrintPhoto[]
}

// ─── Catalog (global, product facts only) ────────────────────────────────────
// No ownership, prices or quantities live here. Later price comparison hangs
// offers and price history off FilamentProduct, never off an owned Spool.

enum Material {
  PLA
  PETG
  ABS
  ASA
  TPU
  PA
  PC
  PET
  HIPS
  PVA
  OTHER
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  /// Lowercased, trimmed name: "Bambu Lab" and "bambu lab " are one brand.
  nameKey   String   @unique
  createdAt DateTime @default(now())

  products FilamentProduct[]
}

model FilamentProduct {
  id           String   @id @default(cuid())
  brandId      String
  /// Product line as the brand names it, e.g. "PLA Basic", "PLA Matte".
  productLine  String
  material     Material
  colorName    String
  /// "#rrggbb", lowercase.
  colorHex     String
  /// 1.75 mm = 1750. Integer micrometres, no floats.
  diameterUm   Int      @default(1750)
  /// Nominal filament weight on a full spool, e.g. 1000.
  netWeightG   Int
  /// Typical empty-spool weight; pre-fills new spools of this product.
  spoolWeightG Int?
  /// Barcode (EAN/UPC/GTIN) as printed. Not unique: the open catalog lists a few
  /// codes on several products.
  ean          String?
  /// Size UUID in the Open Filament Database; null for products users typed in.
  ofdUuid      String?  @unique
  /// True when the import created the row and may update it. Linked user rows stay false
  /// and are never overwritten.
  ofdManaged   Boolean  @default(false)
  discontinued Boolean  @default(false)
  /// Who added the product. Only they may edit it until there is moderation.
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  spools    Spool[]
  barcodes  ProductBarcode[]

  @@unique([brandId, productLine, material, colorName, diameterUm, netWeightG])
  @@index([material])
  @@index([ean])
}

/// Every barcode known for a product: the spool's and the refill's, GTIN and
/// other codes. `FilamentProduct.ean` stays the one shown; this table is for
/// scanning. A code may sit on several products (the open catalog has a few
/// such duplicates), so it is unique per product only.
model ProductBarcode {
  id        String   @id @default(cuid())
  productId String
  /// Digits only, as `normalizeBarcode` returns them.
  code      String
  /// True when the code is printed on the refill (spool-less) version.
  refill    Boolean  @default(false)
  createdAt DateTime @default(now())

  product FilamentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@index([code])
}

// ─── Inventory (owned by a workshop) ─────────────────────────────────────────

enum SpoolStatus {
  ACTIVE
  EMPTY
  ARCHIVED
}

model Spool {
  id                 String      @id @default(cuid())
  workshopId         String
  productId          String
  /// Fixed short code for the label URL /s/<code> (QR and NFC). Never changes.
  shortCode          String      @unique
  emptySpoolWeightG  Int
  /// Cache of the ledger result; rewritten in the same transaction as every
  /// ledger change. Never written directly.
  remainingG         Int
  purchasePriceCents Int?
  purchasedOn        DateTime?   @db.Date
  purchaseUrl        String?
  location           String?
  notes              String?
  status             SpoolStatus @default(ACTIVE)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  workshop Workshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  product  FilamentProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)
  ledger   SpoolLedgerEntry[]
  /// The AMS slot this spool is loaded in; none means it is on the shelf.
  slot     AmsSlot?
  /// Prints that used this spool. The app refuses to delete a spool with prints
  /// (archive it instead); the database cascades so deleting a workshop works.
  usages   PrintUsage[]

  @@index([workshopId, status])
  @@index([productId])
}

enum LedgerKind {
  /// Anchor: net weight when the spool was added.
  INITIAL
  /// Anchor: net weight from a weighing (gross minus empty spool).
  WEIGHING
  /// Anchor: net weight set by hand.
  CORRECTION
  /// Consumption by a print (phase 3). Counts only while active.
  PRINT
}

/// Remaining weight = value of the latest anchor minus all active PRINT
/// entries with a higher seq. A weighing therefore wins over older prints.
/// See computeRemaining() in @spoolworks/core.
model SpoolLedgerEntry {
  seq       Int        @id @default(autoincrement())
  spoolId   String
  kind      LedgerKind
  valueG    Int
  active    Boolean    @default(true)
  /// Set for PRINT entries: the print usage this consumption belongs to.
  usageId   String?    @unique
  createdAt DateTime   @default(now())

  spool Spool       @relation(fields: [spoolId], references: [id], onDelete: Cascade)
  usage PrintUsage? @relation(fields: [usageId], references: [id], onDelete: Cascade)

  @@index([spoolId, seq])
}

// ─── Printers and AMS (owned by a workshop) ──────────────────────────────────

model Printer {
  id         String   @id @default(cuid())
  workshopId String
  name       String
  /// Free text, e.g. "Bambu Lab P2S".
  model      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workshop Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  units    AmsUnit[]
  prints   Print[]

  @@index([workshopId])
}

/// A filament feeder on a printer: an AMS with 4 slots, or a single slot
/// (AMS HT, external spool holder). Removing it puts its spools back on the shelf.
model AmsUnit {
  id        String   @id @default(cuid())
  printerId String
  /// 1-based order on the printer ("AMS 1", "AMS 2").
  position  Int
  slotCount Int
  createdAt DateTime @default(now())

  printer Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  slots   AmsSlot[]

  @@unique([printerId, position])
}

model AmsSlot {
  id       String  @id @default(cuid())
  unitId   String
  /// 1-based slot number within the unit.
  position Int
  /// Unique: a spool sits in at most one slot. Deleting the spool empties the slot.
  spoolId  String? @unique

  unit  AmsUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  spool Spool?  @relation(fields: [spoolId], references: [id], onDelete: SetNull)

  @@unique([unitId, position])
}

// ─── Prints (owned by a workshop) ─────────────────────────────────────────────

enum PrintStatus {
  /// Not printed yet: no consumption is booked.
  PLANNED
  PRINTED
  /// Failed prints still used filament and deduct what was entered.
  FAILED
}

enum ModelSource {
  MAKERWORLD
  PRINTABLES
  THINGIVERSE
  OTHER
}

model Print {
  id          String       @id @default(cuid())
  workshopId  String
  printerId   String?
  name        String
  status      PrintStatus  @default(PRINTED)
  printedOn   DateTime?    @db.Date
  durationMin Int?
  modelUrl    String?
  modelSource ModelSource?
  /// Secret link /p/<shareToken>; null = private. Shared prints also show in the public gallery.
  shareToken  String?      @unique
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workshop Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  printer  Printer?     @relation(fields: [printerId], references: [id], onDelete: SetNull)
  usages   PrintUsage[]
  photos   PrintPhoto[]

  @@index([workshopId, printedOn])
}

/// A photo of a print, stored in the private Vercel Blob store. Position 0 is the cover.
/// The blobs are not removed by the cascade: whoever deletes rows deletes their
/// pathnames from Blob first (lib/photos.ts).
model PrintPhoto {
  id            String   @id @default(cuid())
  workshopId    String
  printId       String
  position      Int
  /// Random Blob pathnames, unique across every environment sharing the store.
  pathname      String   @unique
  thumbPathname String   @unique
  contentType   String
  width         Int
  height        Int
  bytes         Int
  createdAt     DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  print    Print    @relation(fields: [printId], references: [id], onDelete: Cascade)

  /// Also caps concurrent uploads: two requests cannot claim the same slot.
  @@unique([printId, position])
  @@index([workshopId])
}

/// Grams one print took from one spool. Its PRINT ledger entry exists only
/// while the print is printed or failed, and is updated in place on edits so
/// it keeps its position relative to weighings.
model PrintUsage {
  id      String @id @default(cuid())
  printId String
  spoolId String
  grams   Int

  print       Print             @relation(fields: [printId], references: [id], onDelete: Cascade)
  spool       Spool             @relation(fields: [spoolId], references: [id], onDelete: Cascade)
  ledgerEntry SpoolLedgerEntry?

  @@unique([printId, spoolId])
  @@index([spoolId])
}

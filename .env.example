# Single env file for the whole monorepo, at the repo root.
# Both apps/web (next.config.ts) and packages/database (Prisma config) load it explicitly.

# Neon: pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/dev_spoolworks?sslmode=verify-full"
# Neon: direct connection (same URL without "-pooler"), used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/dev_spoolworks?sslmode=verify-full"

# Local `prisma dev` only: it accepts one connection at a time. Leave unset on Neon.
# DATABASE_POOL_MAX=1
# Local `prisma dev` only: its shadow database (second port from `prisma dev ls`), for `migrate dev`.
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated addresses that may open /admin (create password reset links by hand).
# Empty: nobody.
ADMIN_EMAILS=""
# Shown on /auth/forgot: where to write if no reset mail arrives (or, without SMTP, to get a link).
SUPPORT_EMAIL=""

# Outgoing mail (password reset) through one Gmail account: needs 2-step verification
# and an app password (Google account > Security > App passwords). Both unset: no mail,
# resets go through SUPPORT_EMAIL and /admin.
SMTP_USER=""
SMTP_PASSWORD=""
# Only for another provider than Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# Vercel Blob (from phase 3 on)
# BLOB_READ_WRITE_TOKEN=""
